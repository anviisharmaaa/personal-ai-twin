# backend/.env  (copy this block; NEVER commit real values)
APP_ENV=development
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me-publishable-key
# Only if your project signs JWTs with the legacy shared secret; leave empty for asymmetric keys
SUPABASE_JWT_SECRET=
# Reserved for later stages; unused now. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# --- AI provider for CHARACTER ANALYSIS (explicit; never inferred from keys; no fallback) ---------------------
# nvidia = free development endpoint (NVIDIA NIM). openai = paid, for later. mock = fixed sample output, no network
# (refused when APP_ENV=production). Empty = AI off.
AI_PROVIDER=nvidia
# NVIDIA: key from build.nvidia.com (starts nvapi-). Free tier is for testing/evaluation; use fictional text only.
# Model verified on build.nvidia.com with a "Free Endpoint" label on 2026-10-14. The code has no default model.
NVIDIA_API_KEY=
NVIDIA_CHARACTER_MODEL=nvidia/nemotron-3-super-120b-a12b
# guided_json (NIM's documented structured output) or prompt (schema in the prompt, strict validation after)
NVIDIA_JSON_MODE=guided_json
# OpenAI (only when AI_PROVIDER=openai). Model verified in OpenAI's catalogue on 2026-10-14
# ($0.10 / 1M input, $0.50 / 1M output tokens). Any future chat model gets its own separate setting.
# (OPENAI_CHAT_MODEL, used briefly on the branch, is ignored. Rename it to OPENAI_CHARACTER_MODEL.)
OPENAI_API_KEY=
OPENAI_CHARACTER_MODEL=gpt-6-luna
# Kill switch for all external AI calls, and a per-user cap on analyses per rolling 24h.
AI_ENABLED=true
ANALYSIS_DAILY_LIMIT=10
CORS_ORIGINS=http://localhost:5173

# frontend/.env.local
# VITE_API_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-me-publishable-key
