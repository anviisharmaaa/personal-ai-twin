# backend/.env  (copy this block; NEVER commit real values)
APP_ENV=development
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me-publishable-key
# Only if your project signs JWTs with the legacy shared secret; leave empty for asymmetric keys
SUPABASE_JWT_SECRET=
# Reserved for later stages; unused now. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Chosen explicitly by you from OpenAI's official model list; there is deliberately no default and the app
# never switches models on its own. Character analysis stays off ("not configured") until this is set.
OPENAI_CHAT_MODEL=
# Kill switch for all external AI calls, and a per-user cap on analyses per rolling 24h.
AI_ENABLED=true
ANALYSIS_DAILY_LIMIT=10
CORS_ORIGINS=http://localhost:5173

# frontend/.env.local
# VITE_API_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-me-publishable-key
