# backend/.env  (copy this block; NEVER commit real values)
APP_ENV=development
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me-publishable-key
# Only if your project signs JWTs with the legacy shared secret; leave empty for asymmetric keys
SUPABASE_JWT_SECRET=
# Reserved for later stages; unused now. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# --- AI provider for CHARACTER ANALYSIS (explicit; never inferred from keys; no fallback) ---------------------
# nvidia = free development endpoint (NVIDIA NIM, fictional text only). ollama = local model. openai = paid, for later. mock = fixed sample output, no network
# (refused when APP_ENV=production). Empty = AI off.
AI_PROVIDER=nvidia
# NVIDIA: key from build.nvidia.com (starts nvapi-). Free tier is for testing/evaluation; use fictional text only.
# Model verified on build.nvidia.com with a "Free Endpoint" label on 2026-10-14. The code has no default model.
NVIDIA_API_KEY=
NVIDIA_CHARACTER_MODEL=nvidia/nemotron-3-super-120b-a12b
# guided_json (NIM's documented structured output) or prompt (schema in the prompt, strict validation after)
NVIDIA_JSON_MODE=guided_json
# Output-token budget for NVIDIA only (512..8192, default 4096). Reasoning is disabled in the request
# (chat_template_kwargs.enable_thinking=false), so this only has to hold the JSON profile.
NVIDIA_MAX_OUTPUT_TOKENS=4096
# OpenAI (only when AI_PROVIDER=openai). Model verified in OpenAI's catalogue on 2026-10-14
# ($0.10 / 1M input, $0.50 / 1M output tokens). Any future chat model gets its own separate setting.
# (OPENAI_CHAT_MODEL, used briefly on the branch, is ignored. Rename it to OPENAI_CHARACTER_MODEL.)
OPENAI_API_KEY=
OPENAI_CHARACTER_MODEL=gpt-6-luna
# Ollama (only when AI_PROVIDER=ollama): local inference, no API key. The description is processed on THIS computer
# (the app itself still uses Supabase). The endpoint must be loopback unless OLLAMA_ALLOW_REMOTE=true (not advised).
# Set the model to one you have actually installed (`ollama list`); nothing is downloaded for you.
# Start the server with OLLAMA_CONTEXT_LENGTH=16384 so long descriptions are not silently truncated.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHARACTER_MODEL=
OLLAMA_ALLOW_REMOTE=false
# schema (json_schema response_format) | prompt (schema in the prompt only)
OLLAMA_JSON_MODE=schema
OLLAMA_REASONING_EFFORT=none
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_TIMEOUT_SECONDS=600
# Character CHAT (separate from the analysis settings above). Chat talks to Ollama's native /api/chat, derived from
# OLLAMA_BASE_URL. Ceiling on one reply in tokens (a safety limit, not a target; the prompt asks for short replies).
CHAT_MAX_OUTPUT_TOKENS=128
# false = no reasoning phase for ordinary chat (sends think:false). Only set true if you want the model to think first.
CHAT_THINK=false
CHAT_TEMPERATURE=0.7
# 0 = use the Ollama server's own context length. Keep OLLAMA_CONTEXT_LENGTH large enough for the whole description.
CHAT_NUM_CTX=0
# How long Ollama keeps the model loaded after a reply (avoids a reload before the next message).
CHAT_KEEP_ALIVE=30m
# Kill switch for all external AI calls, and a per-user cap on analyses per rolling 24h.
AI_ENABLED=true
ANALYSIS_DAILY_LIMIT=10
CORS_ORIGINS=http://localhost:5173

# frontend/.env.local
# VITE_API_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-me-publishable-key
