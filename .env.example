# backend/.env  (copy this block; NEVER commit real values)
APP_ENV=development
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me-publishable-key
# Only if your project signs JWTs with the legacy shared secret; leave empty for asymmetric keys
SUPABASE_JWT_SECRET=
# Reserved for later stages; unused now. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Model for CHARACTER ANALYSIS only. Verified present in OpenAI's official model catalogue on 2026-10-14
# (pricing listed there: $0.10 / 1M input tokens, $0.50 / 1M output tokens). The code has no default and never
# switches models; change it here, explicitly. Any future chat model gets its own separate setting.
# (OPENAI_CHAT_MODEL, used briefly on the branch, is ignored. Rename it to OPENAI_CHARACTER_MODEL.)
OPENAI_CHARACTER_MODEL=gpt-6-luna
# Kill switch for all external AI calls, and a per-user cap on analyses per rolling 24h.
AI_ENABLED=true
ANALYSIS_DAILY_LIMIT=10
CORS_ORIGINS=http://localhost:5173

# frontend/.env.local
# VITE_API_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-me-publishable-key
